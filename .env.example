# Zkopíruj na .env.local a doplň hodnoty z Supabase (Project Settings → API Keys).
#
# Publishable klíč JE určený do prohlížeče a není tajemství — data chrání RLS,
# ne utajení klíče. Servisní klíč (service_role) sem NIKDY nepatří, ten obchází
# všechna pravidla a smí žít jen na serveru.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
